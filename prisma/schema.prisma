// ─────────────────────────────────────────────────────────────────────────────
// Maeum Global — Prisma schema (fonte única de verdade)
//
// Convenções:
//  * Tabelas legadas `maeum_*` foram REMOVIDAS (não usadas pelo app).
//    O script `aplicar.sql` faz o DROP delas e migra os dados do CMS.
//  * Campos de arrays/JSON são armazenados como `String` (JSON serializado)
//    para manter o painel do Supabase legível.
//  * Datas usam `DateTime` (timestamp without time zone) — gravadas em UTC.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Identidade e acesso ──────────────────────────────────────────────────────

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  role     String  @default("customer") // super_admin | admin | consultora | customer
  phone    String?
  avatarUrl String?
  bio       String?
  jobTitle  String?
  locale    String  @default("pt")

  /// scrypt hash — NUNCA armazene texto puro. Ver src/lib/password.ts
  passwordHash String?

  isActive Boolean @default(true)

  /// Incrementado ao trocar senha/role para invalidar sessões emitidas antes.
  sessionVersion Int       @default(0)
  lastLoginAt     DateTime?

  /// Recuperação de senha: guarda apenas o HASH do token e a validade.
  resetTokenHash   String?
  resetTokenExpiry DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  adminLogs      AdminLog[]    @relation("AdminUserLogs")
  clientBookings Booking[]      @relation("ClientBookings")
  chats          Chat[]         @relation("ConsultantChats")
  clientChats    Chat[]         @relation("CustomerChats")
  assignedLeads  Lead[]         @relation("ConsultantLeads")
  notifications  Notification[] @relation("UserNotifications")
  proposals      Proposal[]     @relation("ConsultantProposals")
  clientProposals Proposal[]    @relation("CustomerProposals")
  documents      Document[]     @relation("ClientDocuments")
  uploadedDocs   Document[]     @relation("DocumentUploader")
  mediaAssets    MediaAsset[]

  @@index([role, isActive])
  @@index([createdAt])
}

model Notification {
  id       String  @id @default(uuid())
  userId   String
  title    String
  message  String
  type     String  @default("info") // info | success | warning | error
  priority String  @default("normal") // low | normal | high
  category String  @default("system") // system | chat | lead | booking | proposal
  isRead   Boolean @default(false)
  linkUrl  String?
  iconName String?
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

// ── CRM ──────────────────────────────────────────────────────────────────────

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String   @default("")
  phone        String?
  destination  String?
  budget       Float?
  /// novo | contato | proposta | proposta_enviada | fechado | perdido
  status       String   @default("novo")
  notes        String?
  origin       String? // origem: site, chat, instagram, indicacao...
  consultantId String?
  lastContactedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  consultant   User?    @relation("ConsultantLeads", fields: [consultantId], references: [id], onDelete: SetNull)
  chats        Chat[]
  proposals    Proposal[]

  @@index([status])
  @@index([consultantId])
  @@index([createdAt])
  @@index([email])
}

// ── Chat ─────────────────────────────────────────────────────────────────────

model Chat {
  id           String    @id @default(uuid())
  /// Atendente responsável (sempre um User com role consultora/admin).
  consultantId String
  /// Cliente autenticado (portal). NULL em chats iniciados por visitante.
  customerId   String?
  /// Lead capturado pelo widget público. NULL em chats do portal do cliente.
  leadId       String?

  status       String    @default("open") // open | pending | closed
  subject      String?
  lastMessageAt DateTime @default(now())
  lastMessagePreview String?
  /// Última vez que o atendente abriu a conversa (badge de não lidas).
  readAt       DateTime?
  closedAt     DateTime?
  /// sha256(visitorToken) do visitante anônimo. É a prova de posse do chat:
  /// sem esse hash ninguém consegue ler nem escrever numa conversa de visitante.
  /// NULL em chats do portal do cliente (esses usam `customerId`).
  visitorTokenHash String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  consultant User @relation("ConsultantChats", fields: [consultantId], references: [id], onDelete: Cascade)
  customer   User? @relation("CustomerChats", fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]

  @@index([consultantId, status, lastMessageAt])
  @@index([customerId])
  @@index([leadId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id        String  @id @default(uuid())
  chatId    String
  /// User.id do autor. NULL = mensagem do visitante anônimo.
  senderId  String?
  /// 'visitor' | 'consultant' | 'system'
  senderType String @default("visitor")
  content   String
  /// Chave idempotente gerada no cliente — impede mensagem duplicada.
  clientKey String?
  readAt    DateTime?
  attachmentUrl  String?
  attachmentType String?
  attachmentName String?
  createdAt DateTime @default(now())

  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([chatId, clientKey])
  @@index([chatId, createdAt])
}

// ── Propostas e vendas ───────────────────────────────────────────────────────

model Proposal {
  id           String   @id @default(uuid())
  title        String
  totalValue   Float
  /// draft | sent | viewed | approved | rejected | expired
  status       String   @default("draft")
  uniqueLink   String?  @unique
  consultantId String
  /// Cliente (User). NULL quando a proposta pertence apenas a um Lead.
  customerId   String?
  leadId       String?
  version      Int      @default(1)
  notes        String?
  validUntil   DateTime?
  viewedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings   Booking[]
  consultant User           @relation("ConsultantProposals", fields: [consultantId], references: [id], onDelete: Cascade)
  customer   User?          @relation("CustomerProposals", fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  items      ProposalItem[]

  @@index([customerId])
  @@index([consultantId])
  @@index([status])
}

model ProposalItem {
  id         String  @id @default(uuid())
  proposalId String
  name       String
  type       String  @default("package") // package | experience | journey | service | discount
  refId      String?
  quantity   Int     @default(1)
  price      Float
  details    String?
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Package {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  destination String?
  price       Float
  /// drip | standard | luxury | experience
  category    String    @default("standard")
  description String?
  gallery     String    @default("[]")
  itinerary   String    @default("[]")
  included    String    @default("[]")
  notIncluded String    @default("[]")
  status      String    @default("active") // active | inactive
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@index([status])
  @@index([destination])
}

model Booking {
  id         String            @id @default(uuid())
  clientId   String
  packageId  String?
  proposalId String?
  /// pending | confirmed | in_progress | completed | cancelled
  status     String            @default("confirmed")
  startDate  DateTime?
  endDate    DateTime?
  totalPrice Float?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  client     User              @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Cascade)
  package    Package?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  proposal   Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  timeline   BookingTimeline[]
  payments   Payment[]

  @@index([clientId])
  @@index([status])
  @@index([startDate])
}

model BookingTimeline {
  id          String   @id @default(uuid())
  bookingId   String
  eventDate   DateTime
  eventTime   String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, eventDate])
}

model Payment {
  id              String    @id @default(uuid())
  bookingId       String
  clientId        String?
  stripeSessionId String?   @unique
  stripePaymentId String?
  amount          Float
  /// pending | paid | failed | refunded | cancelled
  status          String    @default("pending")
  paymentMethod   String?
  /// Link de pagamento gerado no painel (Pix/boleto/transferência).
  paymentUrl      String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt @default(now())
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status, createdAt])
  @@index([paidAt])
}

// ── Catálogo público ─────────────────────────────────────────────────────────

model Category {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  nameEn      String?
  nameEs      String?
  destination String               @default("Coreia do Sul")
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  experiences ExperienceCategory[]

  @@index([isActive, sortOrder])
}

model Experience {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  titleEn        String?
  titleEs        String?
  subtitle       String?
  subtitleEn     String?
  subtitleEs     String?
  location       String   @default("Seul")
  region         String   @default("Seul")
  city           String   @default("Seul")
  description    String?
  descriptionEn  String?
  descriptionEs  String?
  highlights     String   @default("[]")
  highlightsEn   String   @default("[]")
  highlightsEs   String   @default("[]")
  included       String   @default("[]")
  includedEn     String   @default("[]")
  includedEs     String   @default("[]")
  durationHours  Float    @default(2)
  pricePerPerson Float    @default(0)
  priceCurrency  String   @default("BRL")
  mainImage      String?
  gallery        String   @default("[]")
  videoUrl       String?
  videoEmbed     String?
  /// active | inactive
  status         String   @default("active")
  /// direct | request
  bookingType    String   @default("direct")
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  availableFrom  DateTime?
  partnerId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  partner        Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  categories     ExperienceCategory[]

  @@index([status, sortOrder])
  @@index([bookingType])
  @@index([isFeatured])
}

model ExperienceCategory {
  experienceId String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([experienceId, categoryId])
  @@index([categoryId])
}

model KbeautyExperience {
  id                  String   @id @default(uuid())
  slug                String   @unique
  title               String
  subtitle            String?
  location            String   @default("Seul")
  description         String?
  highlights          String   @default("[]")
  included            String   @default("[]")
  durationHours       Float    @default(2)
  pricePerPerson      Float    @default(0)
  priceCurrency       String   @default("BRL")
  mainImage           String?
  gallery             String   @default("[]")
  status              String   @default("active")
  bookingType         String   @default("request")
  isPartnerExperience Boolean  @default(false)
  isIncludedInJourney Boolean  @default(false)
  partnerId           String?
  availableFrom       DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status])
}

model Partner {
  id           String       @id @default(uuid())
  name         String
  category     String?
  contactEmail String?
  phone        String?
  website      String?
  logoUrl      String?
  description  String?
  status       String       @default("active")
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  experiences  Experience[]

  @@index([status])
  @@index([category])
}

model ExchangeInstitution {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  country     String           @default("Coreia do Sul")
  website     String?
  logoUrl     String?
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  campuses    ExchangeCampus[]
}

model ExchangeCampus {
  id            String              @id @default(uuid())
  institutionId String
  name          String
  city          String
  location      String?
  description   String?
  mainImage     String?
  isActive      Boolean             @default(true)
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())
  institution   ExchangeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs      ExchangeProgram[]

  @@index([institutionId])
}

model ExchangeProgram {
  id                 String   @id @default(uuid())
  campusId           String
  name               String
  slug               String   @unique
  description        String?
  durationWeeksMin   Int      @default(1)
  durationWeeksMax   Int      @default(52)
  classesPerWeek     Int      @default(20)
  levelRequired      String   @default("Todos os níveis")
  pricingTiers       String   @default("[]")
  includesEnrollment Boolean  @default(true)
  enrollmentFee      Float    @default(0)
  includesMaterial   Boolean  @default(false)
  materialFee        Float    @default(0)
  culturalActivities Boolean  @default(true)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  campus             ExchangeCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
  @@index([isActive])
}

model Journey {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  titleEn        String?
  titleEs        String?
  subtitle       String?
  subtitleEn     String?
  subtitleEs     String?
  concept        String?
  conceptEn      String?
  conceptEs      String?
  destinations   String   @default("[]")
  durationDays   Int      @default(10)
  totalSpots     Int      @default(15)
  accommodation  String?
  pricePerPerson Float    @default(0)
  priceCurrency  String   @default("BRL")
  mainImage      String?
  gallery        String   @default("[]")
  videoUrl       String?
  videoEmbed     String?
  included       String   @default("[]")
  includedEn     String   @default("[]")
  includedEs     String   @default("[]")
  notIncluded    String   @default("[]")
  notIncludedEn  String   @default("[]")
  notIncludedEs  String   @default("[]")
  itinerary      String   @default("[]")
  highlights     String   @default("[]")
  paymentOptions String   @default("{}")
  /// active | inactive | soldout
  status         String   @default("active")
  /// army | premium | essence | luxury
  category       String   @default("premium")
  isFeatured     Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  departures     JourneyDeparture[]

  @@index([status, sortOrder])
  @@index([category])
  @@index([isFeatured])
}

model JourneyDeparture {
  id              String   @id @default(uuid())
  journeyId       String
  startDate       DateTime
  endDate         DateTime
  totalSpots      Int      @default(15)
  availableSpots  Int      @default(15)
  /// available | limited | sold_out | cancelled
  status          String   @default("available")
  notes           String?
  priceAdjustment Float    @default(0)
  createdAt       DateTime @default(now())
  journey         Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([startDate])
  @@index([status])
}

model Destination {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  country        String
  subtitle       String?
  description    String?
  descriptionEn  String?
  descriptionEs  String?
  mainImage      String?
  gallery        String   @default("[]")
  mapLat         Float?
  mapLng         Float?
  isFeatured     Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isFeatured, sortOrder])
}

// ── Conteúdo ─────────────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  titleEn     String?
  titleEs     String?
  excerpt     String?
  excerptEn   String?
  excerptEs   String?
  content     String    @default("")
  author      String    @default("Maeum Editorial")
  coverImage  String?
  tags        String    @default("[]")
  /// draft | published
  status      String    @default("draft")
  readingMinutes Int    @default(4)
  seoTitle    String?
  seoDesc     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  destination String?
  text        String
  rating      Int      @default(5)
  avatarUrl   String?
  /// pending | approved | rejected
  status      String   @default("pending")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status, sortOrder])
}

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("Geral")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive, sortOrder])
}

/// Configuração estruturada editável no painel (seções: brand, contact, social,
/// legal, seo, visual...). Substitui a leitura morta que existia antes.
model SiteConfig {
  id        String   @id @default(uuid())
  section   String
  configKey String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, configKey])
  @@index([section])
}

/// Chave/valor genérico para blobs CMS (textos e mídias editáveis).
/// Substitui a antiga tabela `maeum_site_settings`.
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @default(now())
}

/// Snapshot em JSONB das 41 tabelas `maeum_*` legadas, gravado por `aplicar.sql`
/// antes do DROP. Não é usada pela aplicação — existe só para recuperação.
model LegacyArchiveMaeum {
  tableName  String   @id @map("table_name")
  data       Json
  archivedAt DateTime @default(now())

  @@map("legacy_archive_maeum")
}

model NavigationItem {
  id             String   @id @default(uuid())
  parentId       String?
  navigationType String   @default("main") // main | footer | legal | social
  label          String
  labelEn        String?
  labelEs        String?
  url            String
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([navigationType, isActive, sortOrder])
}

model CmsPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  seoTitle  String?
  seoDesc   String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CmsBlock {
  id        String   @id @default(uuid())
  pageName  String   @default("home")
  sectionId String
  blockType String
  content   String   @default("{}")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageName, isActive, sortOrder])
}

// ── Mídia ────────────────────────────────────────────────────────────────────

/// Binários de imagem enviados pelo painel. Servidos por /api/media/[id].
/// Guardar no Postgres evita depender de service_role / Edge Functions do Supabase.
model MediaAsset {
  id           String   @id @default(uuid())
  filename     String
  mimeType     String   @default("image/webp")
  size         Int      @default(0)
  width        Int?
  height       Int?
  alt          String?
  folder       String   @default("geral")
  data         Bytes
  uploadedById String?
  createdAt    DateTime @default(now())
  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder, createdAt])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(uuid())
  clientId     String
  uploadedById String
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     String   @default("general")
  notes        String?
  createdAt    DateTime @default(now())

  client   User  @relation("ClientDocuments", fields: [clientId], references: [id], onDelete: Cascade)
  uploader User  @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([category])
}

// ── Auditoria ────────────────────────────────────────────────────────────────

model AdminLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  result    String   @default("success")
  createdAt DateTime @default(now())
  user      User     @relation("AdminUserLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}
