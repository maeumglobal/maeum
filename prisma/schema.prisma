generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String         @id @default(uuid())
  name           String
  email          String         @unique
  passwordHash   String?
  role           String         @default("customer")
  phone          String?
  avatarUrl      String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  adminLogs      AdminLog[]     @relation("AdminUserLogs")
  clientBookings Booking[]      @relation("ClientBookings")
  chats          Chat[]         @relation("ConsultantChats")
  assignedLeads  Lead[]         @relation("ConsultantLeads")
  notifications  Notification[] @relation("UserNotifications")
  proposals      Proposal[]     @relation("ConsultantProposals")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String    @default("info")
  priority  String    @default("normal")
  category  String    @default("system")
  isRead    Boolean   @default(false)
  linkUrl   String?
  iconName  String?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  user      User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Lead {
  id           String   @id @default(uuid())
  name         String
  email        String   @default("")
  phone        String?
  destination  String?
  budget       Float?
  status       String   @default("novo")
  notes        String?
  origin       String?
  consultantId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  consultant   User?    @relation("ConsultantLeads", fields: [consultantId], references: [id])

  @@index([status])
  @@index([consultantId])
  @@index([createdAt])
}

model Chat {
  id           String        @id @default(uuid())
  consultantId String
  customerId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  consultant   User          @relation("ConsultantChats", fields: [consultantId], references: [id])
  messages     ChatMessage[]

  @@index([customerId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  chatId         String
  senderId       String
  content        String
  attachmentUrl  String?
  attachmentType String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())
  chat           Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Proposal {
  id           String         @id @default(uuid())
  title        String
  totalValue   Float
  status       String         @default("draft")
  uniqueLink   String?        @unique
  consultantId String
  customerId   String
  leadId       String?
  version      Int            @default(1)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  bookings     Booking[]
  consultant   User           @relation("ConsultantProposals", fields: [consultantId], references: [id])
  items        ProposalItem[]

  @@index([customerId])
  @@index([status])
}

model ProposalItem {
  id         String   @id @default(uuid())
  proposalId String
  name       String
  type       String
  price      Float
  details    String?
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Package {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  destination String?
  price       Float
  description String?
  gallery     String    @default("[]")
  itinerary   String    @default("[]")
  included    String    @default("[]")
  notIncluded String    @default("[]")
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@index([status])
  @@index([destination])
}

model Booking {
  id         String            @id @default(uuid())
  clientId   String
  packageId  String?
  proposalId String?
  status     String            @default("confirmed")
  startDate  DateTime?
  endDate    DateTime?
  totalPrice Float?
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  client     User              @relation("ClientBookings", fields: [clientId], references: [id])
  package    Package?          @relation(fields: [packageId], references: [id])
  proposal   Proposal?         @relation(fields: [proposalId], references: [id])
  timeline   BookingTimeline[]
  payments   Payment[]

  @@index([clientId])
  @@index([status])
}

model BookingTimeline {
  id          String   @id @default(uuid())
  bookingId   String
  eventDate   DateTime
  eventTime   String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id              String    @id @default(uuid())
  bookingId       String
  clientId        String?
  stripeSessionId String?   @unique
  stripePaymentId String?
  amount          Float
  status          String    @default("pending")
  paymentMethod   String?
  dueDate         DateTime?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
  @@index([clientId])
}

model Category {
  id          String               @id @default(uuid())
  slug        String               @unique
  name        String
  destination String               @default("Coreia do Sul")
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  experiences ExperienceCategory[]

  @@index([isActive])
}

model Experience {
  id             String               @id @default(uuid())
  slug           String               @unique
  title          String
  subtitle       String?
  location       String               @default("Seul")
  region         String               @default("Seul")
  city           String               @default("Seul")
  description    String?
  highlights     String               @default("[]")
  included       String               @default("[]")
  durationHours  Float                @default(2)
  pricePerPerson Float                @default(0)
  mainImage      String?
  gallery        String               @default("[]")
  videoUrl       String?
  videoEmbed     String?
  status         String               @default("active")
  bookingType    String               @default("direct")
  availableFrom  DateTime?
  partnerId      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  partner        Partner?             @relation(fields: [partnerId], references: [id])
  categories     ExperienceCategory[]

  @@index([status])
  @@index([bookingType])
}

model ExperienceCategory {
  experienceId String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([experienceId, categoryId])
}

model KbeautyExperience {
  id                  String    @id @default(uuid())
  slug                String    @unique
  title               String
  subtitle            String?
  location            String    @default("Seul")
  description         String?
  highlights          String    @default("[]")
  included            String    @default("[]")
  durationHours       Float     @default(2)
  pricePerPerson      Float     @default(0)
  mainImage           String?
  gallery             String    @default("[]")
  status              String    @default("active")
  bookingType         String    @default("request")
  isPartnerExperience Boolean   @default(false)
  isIncludedInJourney Boolean   @default(false)
  partnerId           String?
  availableFrom       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
}

model Partner {
  id           String       @id @default(uuid())
  name         String
  category     String?
  contactEmail String?
  phone        String?
  website      String?
  logoUrl      String?
  description  String?
  status       String       @default("active")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  experiences  Experience[]

  @@index([status])
  @@index([category])
}

model ExchangeInstitution {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  country     String           @default("Coreia do Sul")
  website     String?
  logoUrl     String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  campuses    ExchangeCampus[]
}

model ExchangeCampus {
  id            String              @id @default(uuid())
  institutionId String
  name          String
  city          String
  location      String?
  description   String?
  mainImage     String?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  institution   ExchangeInstitution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  programs      ExchangeProgram[]

  @@index([institutionId])
}

model ExchangeProgram {
  id                 String         @id @default(uuid())
  campusId           String
  name               String
  slug               String         @unique
  description        String?
  durationWeeksMin   Int            @default(1)
  durationWeeksMax   Int            @default(52)
  classesPerWeek     Int            @default(20)
  levelRequired      String         @default("Todos os n├¡veis")
  pricingTiers       String         @default("[]")
  includesEnrollment Boolean        @default(true)
  enrollmentFee      Float          @default(0)
  includesMaterial   Boolean        @default(false)
  materialFee        Float          @default(0)
  culturalActivities Boolean        @default(true)
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  campus             ExchangeCampus @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([campusId])
}

model Journey {
  id             String             @id @default(uuid())
  slug           String             @unique
  title          String
  subtitle       String?
  concept        String?
  destinations   String             @default("[]")
  durationDays   Int                @default(10)
  totalSpots     Int                @default(15)
  accommodation  String?
  pricePerPerson Float              @default(0)
  priceCurrency  String             @default("BRL")
  mainImage      String?
  gallery        String             @default("[]")
  videoUrl       String?
  videoEmbed     String?
  included       String             @default("[]")
  notIncluded    String             @default("[]")
  itinerary      String             @default("[]")
  highlights     String             @default("[]")
  paymentOptions String             @default("{}")
  status         String             @default("active")
  category       String             @default("premium")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  departures     JourneyDeparture[]

  @@index([status])
  @@index([category])
}

model JourneyDeparture {
  id              String   @id @default(uuid())
  journeyId       String
  startDate       DateTime
  endDate         DateTime
  totalSpots      Int      @default(15)
  availableSpots  Int      @default(15)
  status          String   @default("available")
  notes           String?
  priceAdjustment Float    @default(0)
  createdAt       DateTime @default(now())
  journey         Journey  @relation(fields: [journeyId], references: [id], onDelete: Cascade)

  @@index([journeyId])
  @@index([startDate])
}

model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String    @default("")
  author      String    @default("Maeum Editor")
  coverImage  String?
  tags        String    @default("[]")
  status      String    @default("draft")
  seoTitle    String?
  seoDesc     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([publishedAt])
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  destination String?
  text        String
  rating      Int      @default(5)
  avatarUrl   String?
  status      String   @default("pending")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([status])
}

model FaqItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("Geral")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model SiteConfig {
  id        String   @id @default(uuid())
  section   String
  configKey String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([section, configKey])
  @@index([section])
}

model NavigationItem {
  id             String   @id @default(uuid())
  parentId       String?
  navigationType String   @default("main")
  label          String
  url            String
  icon           String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([navigationType, isActive])
}

model CmsPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  content   String   @default("")
  seoTitle  String?
  seoDesc   String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model CmsBlock {
  id        String   @id @default(uuid())
  pageName  String   @default("home")
  sectionId String
  blockType String
  content   String   @default("{}")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageName, isActive])
}

model Destination {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  country        String
  description    String?
  mainImage      String?
  gallery        String   @default("[]")
  mapLat         Float?
  mapLng         Float?
  isFeatured     Boolean  @default(true)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isFeatured])
}

model AdminLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  result    String   @default("success")
  createdAt DateTime @default(now())
  user      User     @relation("AdminUserLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

model Document {
  id           String   @id @default(uuid())
  clientId     String
  uploadedById String
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  category     String   @default("general")
  notes        String?
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([category])
}

